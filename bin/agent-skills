#!/usr/bin/env bash
#
# agent-skills: one checkout of this collection per machine, linked to where
# the agents and the projects look for it.
#
#   agent-skills install      put this command on PATH and link every skill
#                             for Claude Code, Kilo Code and Cline
#   agent-skills update       pull the remote's commits or push local ones,
#                             then relink and refresh a registered marketplace
#   agent-skills link [DIR]   link the checkout into a project as DIR/agent-skills
#
# Use existing ~/.claude, ~/.kilo, ~/.cline and Kilo's XDG config directory.
# Create skills/ only inside an existing agent home; never create agent homes.
#
# The update never merges and never overwrites work. It fast-forwards to the
# remote branch, or pushes the local commits the remote branch lacks. If the
# branches have diverged, or the merge would overwrite local changes, it
# changes nothing and shows how to resolve it with git. Local changes are
# never committed or pushed; it lists them.

set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

# Back up collisions under each agent's own directory. Only exact links created
# by this checkout are owned here; never clean up unrelated skills or links.
linkAgentSkills() {
	local agentHome="$1" skillsDir="$1/skills" agentName="$2"
	local skill name target backupDir="" count=0

	if [ ! -d "$agentHome" ]; then
		echo "$agentName: skipped $agentHome (not an existing directory; not created)."
		return 0
	fi

	mkdir -p "$skillsDir"
	for skill in "$repo"/skills/*/; do
		skill=${skill%/}
		name=$(basename "$skill")
		target="$skillsDir/$name"
		[ -f "$skill/SKILL.md" ] || continue
		count=$((count + 1))
		[ "$(readlink "$target" 2>/dev/null)" = "$skill" ] && continue
		if [ -e "$target" ] || [ -L "$target" ]; then
			if [ -z "$backupDir" ]; then
				mkdir -p "$agentHome/skill-backups"
				backupDir=$(mktemp -d "$agentHome/skill-backups/$(date +%Y%m%dT%H%M%S).XXXXXX")
			fi
			mv "$target" "$backupDir/"
			echo "moved the old $target to $backupDir/"
		fi
		ln -s "$skill" "$target"
		echo "linked $target"
	done

	for target in "$skillsDir"/*; do
		name=$(basename "$target")
		if [ -L "$target" ] && [ "$(readlink "$target")" = "$repo/skills/$name" ] &&
			[ ! -f "$repo/skills/$name/SKILL.md" ]; then
			rm "$target"
			echo "removed $target, which the checkout no longer provides as a skill"
		fi
	done
	echo "$agentName: synchronized $count local skill link(s) in $skillsDir."
}

linkSkills() {
	local kiloConfigHome="${XDG_CONFIG_HOME:-$HOME/.config}/kilo"
	linkAgentSkills "$HOME/.claude" "Claude Code"
	linkAgentSkills "$HOME/.kilo" "Kilo Code"
	if [ "$kiloConfigHome" != "$HOME/.kilo" ]; then
		linkAgentSkills "$kiloConfigHome" "Kilo Code (global config)"
	fi
	linkAgentSkills "$HOME/.cline" "Cline"
}

install() {
	mkdir -p "$HOME/.local/bin"
	ln -sfn "$repo/bin/agent-skills" "$HOME/.local/bin/agent-skills"
	linkSkills

	case :$PATH: in
	*:"$HOME/.local/bin":*) ;;
	*) echo "Add $HOME/.local/bin to PATH to run agent-skills by name; no shell configuration was changed." ;;
	esac
}

# Stop without changing anything, and show how to resolve it with git.
resolveWithGit() {
	cat >&2 <<-EOF
		$1. Nothing was changed. Resolve it with git:
		  cd $repo
		  git status            # commit or stash your local changes
		  git pull --rebase     # rebase onto the remote branch, resolve any conflicts
		  agent-skills update   # push the result
	EOF
	exit 1
}

# Refresh only this collection's already registered catalog. Let Claude use
# its registered source/ref; never register, install, or enable plugins here.
refreshMarketplace() {
	local registered remedy="claude plugin marketplace update ahmedkishki-skills"

	if [ ! -d "$HOME/.claude" ]; then
		echo "Claude marketplace: optional refresh skipped; $HOME/.claude is not an existing directory."
		return 0
	fi
	if ! command -v claude >/dev/null 2>&1; then
		echo "Claude CLI not found on PATH; optional marketplace refresh skipped (local skill links are unaffected). Run '$remedy' when the CLI is available."
		return 0
	fi
	if ! command -v python3 >/dev/null 2>&1; then
		echo "Python 3 not found on PATH; optional marketplace refresh skipped (local skill links are unaffected). Run '$remedy' manually."
		return 0
	fi
	if ! registered=$(claude plugin marketplace list --json | python3 -c '
import json, sys
items = json.load(sys.stdin)
if not isinstance(items, list) or not all(
    isinstance(item, dict) and isinstance(item.get("name"), str) for item in items
):
    raise ValueError("Expected a JSON array of named marketplaces")
print("yes" if any(item["name"] == "ahmedkishki-skills" for item in items) else "no")
'); then
		echo "Git/link update finished, but Claude marketplace lookup failed. Retry with '$remedy'." >&2
		return 1
	fi
	if [ "$registered" = no ]; then
		echo "Claude marketplace ahmedkishki-skills is not registered; optional refresh skipped (local skill links are unaffected)."
		return 0
	fi
	if ! claude plugin marketplace update ahmedkishki-skills; then
		echo "Git/link update finished, but Claude marketplace refresh failed. Retry with '$remedy'." >&2
		return 1
	fi
}

update() {
	local upstream behind ahead

	git -C "$repo" fetch --quiet origin
	upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}')
	behind=$(git -C "$repo" rev-list --count "HEAD..$upstream")
	ahead=$(git -C "$repo" rev-list --count "$upstream..HEAD")
	if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
		resolveWithGit "Your branch and '$upstream' have diverged"
	elif [ "$behind" -gt 0 ]; then
		git -C "$repo" merge --ff-only --quiet "$upstream" ||
			resolveWithGit "Your local changes would be overwritten by merge"
		echo "pulled $behind commit(s) from '$upstream'"
	elif [ "$ahead" -gt 0 ]; then
		git -C "$repo" push --quiet origin HEAD
		echo "pushed $ahead commit(s) to '$upstream'"
	else
		echo "up to date with '$upstream'"
	fi

	if [ -n "$(git -C "$repo" status --porcelain)" ]; then
		echo "local changes not committed, so not pushed:"
		git -C "$repo" status --short
	fi
	linkSkills
	refreshMarketplace
}

# Link the checkout into a project and keep it out of the project's Git through
# .git/info/exclude, which is never committed. The pattern has no trailing
# slash: Git sees a symlink as a file, not a directory.
linkProject() {
	local dir="${1:-.}" link prefix exclude

	dir=$(cd "$dir" && pwd)
	link="$dir/agent-skills"
	if [ "$(readlink "$link")" = "$repo" ]; then
		echo "$link already links to $repo"
	elif [ -e "$link" ] || [ -L "$link" ]; then
		echo "$link already exists; move it away first" >&2
		exit 1
	else
		ln -s "$repo" "$link"
		echo "linked $link"
	fi

	if exclude=$(git -C "$dir" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null); then
		prefix=$(git -C "$dir" rev-parse --show-prefix)
		if ! grep -qxF "/${prefix}agent-skills" "$exclude" 2>/dev/null; then
			mkdir -p "$(dirname "$exclude")"
			echo "/${prefix}agent-skills" >> "$exclude"
			echo "excluded it in $exclude"
		fi
	fi
}

case ${1:-} in
install) install ;;
update) update ;;
link) linkProject "${2:-.}" ;;
*)
	echo "usage: agent-skills install | update | link [DIR]" >&2
	exit 2
	;;
esac
